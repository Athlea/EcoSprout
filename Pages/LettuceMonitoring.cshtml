@page "/monitoring/lettuce"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model EcoSprout.Pages.LettuceMonitoringModel
@{
    Layout = null;
    ViewData["Title"] = "Lettuce Monitoring";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lettuce Monitoring - EcoSprout</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/monitoring.css" asp-append-version="true" />
    <script type="module" src="/js/firebase.js"></script>
    <script type="module" src="/js/lettuce_monitoring.js"></script>
    <script type="module" src="/js/login.js"></script>
</head>
<body>
    @await Html.PartialAsync("_NavbarPartial")

    <main class="plant-monitoring-main">
        <div class="plant-header">
            <div class="plant-image-large">
                <img src="/images/lettuce.jpg" alt="Lettuce">
            </div>
            <div class="plant-title">
                <h1>Lettuce</h1>
                <p class="plant-description">
                    Lettuce is a cool-season crop that grows quickly and provides fresh greens for salads.
                    It prefers consistent moisture and cooler temperatures for optimal growth.
                </p>
            </div>
        </div>
        
       <div class="monitoring-container">
            <div class="monitoring-data">
                <div class="data-card">
                    <h3>Temperature</h3>
                    <div class="data-value" id="tempValue">--°C</div>
                    <div class="data-status optimal" id="tempStatus">Loading...</div>
                </div>
                
                <div class="data-card">
                    <h3>Soil Moisture</h3>
                    <div class="data-value" id="moistureValue">--%</div>
                    <div class="data-status optimal" id="moistureStatus">Loading...</div>
                </div>
            </div>
            
            <div class="watering-section">
                <h2>Watering Controls</h2>
                <div class="watering-controls">
                <div class="auto-toggle">
                    <label class="switch-label">Auto Water Control</label>
                    <label class="switch">
                        <input type="checkbox" id="autoWaterToggle" checked>
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="auto-control-separator"></div>
                    <!-- Manual controls section -->
                <div class="manual-controls" id="manualControls">
                    <div class="control-group">
                        <label for="waterDate">Set Date:</label>
                        <input type="date" id="waterDate" disabled>
                    </div>
                    
                    <div class="control-group">
                        <label for="waterTime">Set Time:</label>
                        <input type="time" id="waterTime" disabled>
                    </div>
                    
                    <div class="control-group">
                        <label for="waterDuration">Set Duration (minutes):</label>
                        <input type="number" id="waterDuration" min="1" step="1" placeholder="Enter duration" disabled>
                    </div>
                    
                    <button class="water-now-button" disabled>Water Now</button>
                </div>
            </div>
            </div>
            
        </div>
        
        <div class="history-section">
            <h2>Watering History</h2>
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Duration</th>
                        <th>Mode</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody">
                    <!-- Watering history will be dynamically inserted here -->
                </tbody>
            </table>
        </div>
    </main>
 
    <footer>
        <p>&copy; 2024 EcoSprout - Smart Irrigation System</p>
    </footer>
</body>
</html> 